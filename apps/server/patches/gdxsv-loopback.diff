@@ -0,0 +1,19 @@
+package main
+
+import (
+	"os"
+	"time"
+)
+
+// mcsReadTimeout is how long a battle TCP peer may stay silent before the MCS
+// drops it. Upstream uses 30 s. Browser clients loading a stage from a remote
+// disc image can be silent longer, so GDXSV_BATTLE_READ_TIMEOUT (a Go
+// duration) may raise it for a private backend.
+var mcsReadTimeout = parseMcsReadTimeout(os.Getenv("GDXSV_BATTLE_READ_TIMEOUT"))
+
+func parseMcsReadTimeout(s string) time.Duration {
+	if d, err := time.ParseDuration(s); err == nil && d > 0 {
+		return d
+	}
+	return 30 * time.Second
+}
