+++ b/gdxsv/mcs_read_timeout_test.go
@@ -0,0 +1,17 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParseMcsReadTimeout(t *testing.T) {
+	for in, want := range map[string]time.Duration{
+		"": 30 * time.Second, "bogus": 30 * time.Second, "0s": 30 * time.Second,
+		"-5s": 30 * time.Second, "2m": 2 * time.Minute, "45s": 45 * time.Second,
+	} {
+		if got := parseMcsReadTimeout(in); got != want {
+			t.Errorf("parseMcsReadTimeout(%q) = %v, want %v", in, got, want)
+		}
+	}
+}
