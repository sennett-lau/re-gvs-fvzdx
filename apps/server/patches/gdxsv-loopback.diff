@@ -0,0 +1,89 @@
+package main
+
+import (
+	"errors"
+	"net"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// nonLoopbackIPv4 returns an address of this machine that is not loopback, so a
+// test can check that a loopback listener is not reachable through it.
+func nonLoopbackIPv4(t *testing.T) net.IP {
+	t.Helper()
+	addrs, err := net.InterfaceAddrs()
+	must(t, err)
+	for _, a := range addrs {
+		if n, ok := a.(*net.IPNet); ok {
+			if ip := n.IP.To4(); ip != nil && !ip.IsLoopback() && !ip.IsLinkLocalUnicast() {
+				return ip
+			}
+		}
+	}
+	t.Skip("no non-loopback IPv4 address on this machine")
+	return nil
+}
+
+func freeLoopbackPort(t *testing.T) int {
+	t.Helper()
+	l, err := net.Listen("tcp4", "127.0.0.1:0")
+	must(t, err)
+	port := l.Addr().(*net.TCPAddr).Port
+	must(t, l.Close())
+	return port
+}
+
+// assertTCPOnlyLoopback requires a TCP listener on 127.0.0.1:port and no TCP
+// listener for the same port on the other address.
+func assertTCPOnlyLoopback(t *testing.T, other net.IP, port int) {
+	t.Helper()
+	loopback := &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: port}
+	conn := dialWithRetry(t, loopback.String(), 5*time.Second)
+	conn.Close()
+	remote := &net.TCPAddr{IP: other, Port: port}
+	if c, err := net.DialTimeout("tcp4", remote.String(), time.Second); err == nil {
+		c.Close()
+		t.Fatalf("TCP listener on port %d is reachable through %v", port, other)
+	}
+}
+
+// assertUDPNotOn requires that a UDP datagram to other:port is refused, which a
+// connected UDP socket reports after the ICMP port-unreachable reply.
+func assertUDPNotOn(t *testing.T, other net.IP, port int) {
+	t.Helper()
+	conn, err := net.DialUDP("udp4", nil, &net.UDPAddr{IP: other, Port: port})
+	must(t, err)
+	defer conn.Close()
+	for i := 0; i < 3; i++ {
+		_, _ = conn.Write([]byte{0})
+		must(t, conn.SetReadDeadline(time.Now().Add(500*time.Millisecond)))
+		_, err = conn.Read(make([]byte, 16))
+		if errors.Is(err, syscall.ECONNREFUSED) {
+			return
+		}
+	}
+	t.Fatalf("UDP port %d on %v was not refused (last error %v)", port, other, err)
+}
+
+// TestLoopbackBinding checks that the lobby (TCP and its UDP responder) and the
+// battle server (TCP and UDP) bind only the configured loopback host. Upstream
+// passed every game listener through stripHost, which bound all interfaces.
+func TestLoopbackBinding(t *testing.T) {
+	other := nonLoopbackIPv4(t)
+
+	lobbyPort := freeLoopbackPort(t)
+	lbs := NewLbs()
+	defer lbs.Quit()
+	go lbs.ListenAndServe(net.JoinHostPort("127.0.0.1", strconv.Itoa(lobbyPort)))
+	assertTCPOnlyLoopback(t, other, lobbyPort)
+	assertUDPNotOn(t, other, lobbyPort)
+
+	battlePort := freeLoopbackPort(t)
+	mcs := NewMcs(0)
+	defer mcs.Quit()
+	mcs.ListenAndServe(net.JoinHostPort("127.0.0.1", strconv.Itoa(battlePort)))
+	assertTCPOnlyLoopback(t, other, battlePort)
+	assertUDPNotOn(t, other, battlePort)
+}
